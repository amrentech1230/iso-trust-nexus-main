APP_NAME="TRAIBCERT Payments API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The React frontend origin(s) allowed to call this API (CORS).
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_ALT=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Default is MySQL. To run instantly without a MySQL server, set
# DB_CONNECTION=sqlite and run: touch database/database.sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=traibcert
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# PayPal
# ---------------------------------------------------------------------------
# Use "sandbox" while testing, switch to "live" for production.
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=GBP

# Sandbox credentials (from https://developer.paypal.com/dashboard/)
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Live credentials
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=

# Optional: webhook id for verifying PayPal webhook signatures.
PAYPAL_WEBHOOK_ID=
