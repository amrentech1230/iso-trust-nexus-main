# --- Frontend (React SPA) environment ---
# Copy to `.env` (or `.env.local`) and adjust as needed.

# Set to "1" to send the enquiry form to the real backend API
# (POST /api/public/enquiry). When empty/unset, the form uses a local mock
# response so the UI works without a running backend.
VITE_BIGIN_ENABLED=1

# Where the Vite dev server proxies /api requests (your Laravel API).
# Defaults to http://localhost:8000 if unset (see vite.config.ts).
VITE_API_PROXY_TARGET=http://localhost:8000

# Optional: reCAPTCHA v3 site key. When set (and grecaptcha is loaded),
# the enquiry form attaches a token to submissions.
# VITE_RECAPTCHA_SITE_KEY=
