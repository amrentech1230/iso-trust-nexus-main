# Frontend environment variables (Vite).
# Copy to `.env` and fill in. Only VITE_* vars are exposed to the browser.

# Base URL of the Laravel payments API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# PayPal CLIENT ID (public — safe in the browser). Use the SANDBOX client id
# while testing, and the LIVE client id in production. This must match the
# credentials configured in the Laravel backend (backend/.env).
VITE_PAYPAL_CLIENT_ID=

# Currency for PayPal checkout. Must match PAYPAL_CURRENCY in the backend.
VITE_PAYPAL_CURRENCY=GBP
